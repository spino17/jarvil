# Generated by Cargo
# will have compiled files and executables
**/target/
scratch
configure.ac
Makefile.am
**/package/
.idea/
.mypy_cache/
# personal editor settings at the repo root, but *not* the extension's own
# launch config, which is part of how the extension is developed
/.vscode/
.DS_Store
Makefile

# ignores from my local machine
scratch-*.jv
tools/anyon/main.jv

# build artifacts generated next to a `.jv` source by `anyon build`/`anyon run`
# (`__ast_<name>.json` and `__transpiled_<name>_py_code__.py`)
__*

# `Cargo.lock` is committed: this workspace builds the `anyon` binary, so builds
# should be reproducible. See
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# VS Code extension build output and dependencies
extensions/jarvil-vscode/node_modules/
extensions/jarvil-vscode/client/out/
extensions/jarvil-vscode/*.vsix

# Zed extension build output (its own cargo workspace, so `**/target/` above
# already covers it -- listed for clarity)
extensions/jarvil-zed/target/

# tree-sitter grammar: the CLI and its build cache. The generated parser under
# `tree-sitter-jarvil/src/` is committed on purpose, so the grammar can be built
# and consumed without installing the tree-sitter CLI.
tree-sitter-jarvil/node_modules/
tree-sitter-jarvil/build/

# Website: dependencies, build output, and the wasm the playground loads
# (regenerated by `npm run wasm`, so not source)
site/node_modules/
site/.vitepress/dist/
site/.vitepress/cache/
site/src/wasm/
