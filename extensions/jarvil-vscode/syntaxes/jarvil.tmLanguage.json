{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Jarvil",
    "scopeName": "source.jarvil",
    "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#declarations" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#numbers" },
        { "include": "#reserved" },
        { "include": "#calls" },
        { "include": "#operators" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.jarvil",
                    "begin": "//",
                    "end": "$",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.comment.jarvil" }
                    }
                },
                {
                    "name": "comment.block.jarvil",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.comment.begin.jarvil" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.comment.end.jarvil" }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.jarvil",
                    "begin": "\"",
                    "end": "\"",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.string.begin.jarvil" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.jarvil" }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jarvil",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.jarvil",
                    "begin": "'",
                    "end": "'",
                    "beginCaptures": {
                        "0": { "name": "punctuation.definition.string.begin.jarvil" }
                    },
                    "endCaptures": {
                        "0": { "name": "punctuation.definition.string.end.jarvil" }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.jarvil",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "declarations": {
            "patterns": [
                {
                    "comment": "function or method declaration, plus the constructor `__init__`",
                    "match": "\\b(def)\\s+(__init__|[A-Za-z_][A-Za-z0-9_]*)?",
                    "captures": {
                        "1": { "name": "storage.type.function.jarvil" },
                        "2": { "name": "entity.name.function.jarvil" }
                    }
                },
                {
                    "comment": "`declare def name` foreign function prototype",
                    "match": "\\b(declare)\\s+(def)\\s+([A-Za-z_][A-Za-z0-9_]*)?",
                    "captures": {
                        "1": { "name": "storage.modifier.jarvil" },
                        "2": { "name": "storage.type.function.jarvil" },
                        "3": { "name": "entity.name.function.jarvil" }
                    }
                },
                {
                    "comment": "`type Name struct|enum` declaration",
                    "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.type.jarvil" },
                        "2": { "name": "entity.name.type.jarvil" }
                    }
                },
                {
                    "comment": "`interface Name` declaration",
                    "match": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.type.interface.jarvil" },
                        "2": { "name": "entity.name.type.interface.jarvil" }
                    }
                },
                {
                    "comment": "`implements Interface`",
                    "match": "\\b(implements)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.modifier.implements.jarvil" },
                        "2": { "name": "entity.name.type.interface.jarvil" }
                    }
                },
                {
                    "comment": "`let name` binding",
                    "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.type.jarvil" },
                        "2": { "name": "variable.other.definition.jarvil" }
                    }
                },
                {
                    "comment": "enum variant or class-method access: `Name::variant`",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.type.jarvil" },
                        "2": { "name": "punctuation.separator.namespace.jarvil" },
                        "3": { "name": "variable.other.enummember.jarvil" }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.jarvil",
                    "match": "\\b(if|elif|else|for|while|continue|break|return|match|case|in)\\b"
                },
                {
                    "name": "storage.type.jarvil",
                    "match": "\\b(def|let|type|interface|struct|enum|lambda|declare)\\b"
                },
                {
                    "name": "storage.modifier.jarvil",
                    "match": "\\b(implements)\\b"
                },
                {
                    "name": "variable.language.self.jarvil",
                    "match": "\\b(self)\\b"
                },
                {
                    "name": "keyword.operator.logical.jarvil",
                    "match": "\\b(and|or|not)\\b"
                }
            ]
        },
        "constants": {
            "name": "constant.language.jarvil",
            "match": "\\b(True|False)\\b"
        },
        "types": {
            "patterns": [
                {
                    "name": "support.type.primitive.jarvil",
                    "match": "\\b(int|float|str|bool)\\b"
                },
                {
                    "comment": "capitalised identifier in a type position, e.g. after `:` or `->`",
                    "match": "(?<=:|->)\\s*\\[?\\s*([A-Z][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "entity.name.type.jarvil" }
                    }
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.jarvil",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.jarvil",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "reserved": {
            "comment": "Reserved so that generated Python stays valid. Using one as an identifier is a syntax error in Jarvil, so flag it rather than let it look like a normal name.",
            "name": "invalid.illegal.reserved.jarvil",
            "match": "\\b(None|as|assert|class|del|except|finally|from|global|import|is|nonlocal|pass|raise|try|with|yield|async|await|__peg_parser__)\\b"
        },
        "calls": {
            "patterns": [
                {
                    "comment": "method call after a dot",
                    "match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.call.jarvil" }
                    }
                },
                {
                    "comment": "plain call, including generic turbofish `f<int>(..)`",
                    "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=(<[^<>()]*>)?\\()",
                    "captures": {
                        "1": { "name": "entity.name.function.call.jarvil" }
                    }
                },
                {
                    "comment": "field or property access",
                    "match": "(?<=\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\b",
                    "captures": {
                        "1": { "name": "variable.other.property.jarvil" }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arrow.jarvil",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.comparison.jarvil",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.assignment.jarvil",
                    "match": "="
                },
                {
                    "name": "keyword.operator.arithmetic.jarvil",
                    "match": "(\\*\\*|\\+|-|\\*|/)"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "name": "punctuation.separator.namespace.jarvil",
                    "match": "::"
                },
                {
                    "name": "punctuation.separator.colon.jarvil",
                    "match": ":"
                },
                {
                    "name": "punctuation.separator.comma.jarvil",
                    "match": ","
                },
                {
                    "name": "punctuation.accessor.jarvil",
                    "match": "\\."
                }
            ]
        }
    }
}
