{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "/*", "close": "*/", "notIn": ["string"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""],
        ["'", "'"]
    ],
    "autoCloseBefore": ":.,=}])> \n\t",
    "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(def|if|elif|else|for|while|match|case|type|interface)\\b.*:\\s*(//.*)?$",
        "decreaseIndentPattern": "^\\s*(elif|else|case)\\b.*:\\s*(//.*)?$"
    },
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:def|if|elif|else|for|while|match|case|type|interface)\\b.*:\\s*$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^\\s*(?:return|break|continue)\\b.*$",
            "action": { "indent": "outdent" }
        }
    ],
    "folding": {
        "offSide": true,
        "markers": {
            "start": "^\\s*//\\s*#?region\\b",
            "end": "^\\s*//\\s*#?endregion\\b"
        }
    }
}
