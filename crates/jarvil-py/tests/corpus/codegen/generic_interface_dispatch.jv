interface Printer:
    def print()

def print_list<T: Printer>(l: [T]):
    for element in l:
        element.print()

type Int struct implements Printer:
    val: int
    def __init__(x: int):
        self.val = x

    def print():
        print(self.val)

def main():
    let x = [Int(1), Int(2)]
    print_list(x)
